# Podman transmet ces surcharges facultatives avec `podman run --env-file .env`.
# Sans surcharge, les valeurs de /etc/ttl-lama/config.yml sont utilisées.
# TTL_LAMA_AUTH_MODE=external
# TTL_LAMA_OIDC_ISSUER=https://identity.example.org
# TTL_LAMA_OIDC_CLIENT_ID=ttl-lama
# TTL_LAMA_OIDC_REDIRECT_URI=https://ttl-lama.example.org/auth/callback
# TTL_LAMA_DB_TYPE=postgresql
# TTL_LAMA_DB_HOST=postgres
# TTL_LAMA_DB_NAME=ttl_lama
# TTL_LAMA_DB_USER=ttl_lama
# Conserver les secrets dans des fichiers montés et utiliser les paramètres *_FILE.
